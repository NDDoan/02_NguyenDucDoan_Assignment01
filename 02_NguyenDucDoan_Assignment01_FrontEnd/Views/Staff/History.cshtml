@model IEnumerable<_02_NguyenDucDoan_Assignment01_FrontEnd.Models.NewsArticleDTO>
@{
    ViewData["Title"] = "News History";
}

<h2>My News History</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Headline</th>
            <th>Category</th>
            <th>Status</th>
            <th>Created Date</th>
        </tr>
    </thead>
    <tbody>
        @if(Model != null)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.NewsArticleId</td>
                    <td>@item.NewsTitle</td>
                    <td>@item.Headline</td>
                    <td>@item.CategoryName</td>
                    <td>@(item.NewsStatus == true ? "Active" : "Inactive")</td>
                    <td>@(item.CreatedDate?.ToString("yyyy-MM-dd HH:mm"))</td>
                </tr>
            }
        }
    </tbody>
</table>
