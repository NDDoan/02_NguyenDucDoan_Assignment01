@model IEnumerable<_02_NguyenDucDoan_Assignment01_FrontEnd.Models.NewsStatisticDTO>
@{
    ViewData["Title"] = "Statistic Report";
    DateTime? startDate = Context.Request.Query["startDate"].Count > 0 ? DateTime.Parse(Context.Request.Query["startDate"]) : (DateTime?)null;
    DateTime? endDate = Context.Request.Query["endDate"].Count > 0 ? DateTime.Parse(Context.Request.Query["endDate"]) : (DateTime?)null;
}

<h2>Statistic Report</h2>

<form method="get" class="row g-3 mb-4">
    <div class="col-auto">
        <label for="startDate" class="form-label">Start Date</label>
        <input type="date" class="form-control" id="startDate" name="startDate" value="@(startDate?.ToString("yyyy-MM-dd"))" required>
    </div>
    <div class="col-auto">
        <label for="endDate" class="form-label">End Date</label>
        <input type="date" class="form-control" id="endDate" name="endDate" value="@(endDate?.ToString("yyyy-MM-dd"))" required>
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">Generate Report</button>
    </div>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model != null && Model.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Category</th>
                <th>Created By</th>
                <th>Created Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderByDescending(m => m.CreatedDate))
            {
                <tr>
                    <td>@item.NewsArticleId</td>
                    <td>@item.NewsTitle</td>
                    <td>@item.CategoryName</td>
                    <td>@item.CreatedByName</td>
                    <td>@(item.CreatedDate?.ToString("yyyy-MM-dd HH:mm"))</td>
                    <td>@(item.NewsStatus == true ? "Active" : "Inactive")</td>
                </tr>
            }
        </tbody>
    </table>
}
else if (startDate.HasValue && endDate.HasValue)
{
    <div class="alert alert-info">No news articles found for the selected period.</div>
}
