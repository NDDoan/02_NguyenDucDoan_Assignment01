@{
    ViewData["Title"] = "Access Denied";
}

<div class="container text-center py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4">
                <div class="mb-3">
                    <span class="badge bg-danger fs-5 px-3 py-2">Access Denied</span>
                </div>
                <h2 class="text-danger fw-bold mb-3">403 - Forbidden</h2>
                <p class="text-muted mb-4">
                    You do not have permission to access this resource.
                </p>
                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">Back to Home</a>
                </div>
            </div>
        </div>
    </div>
</div>
