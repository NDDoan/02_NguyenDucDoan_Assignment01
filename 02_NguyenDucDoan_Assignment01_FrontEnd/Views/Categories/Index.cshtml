@model IEnumerable<_02_NguyenDucDoan_Assignment01_FrontEnd.Models.CategoryDTO>
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="row mb-3">
    <div class="col-md-10">
        <h2>Manage Categories</h2>
    </div>
    <div class="col-md-2 text-end">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">Add New</button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Description</th>
            <th>Parent ID</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CategoryId</td>
                <td>@item.CategoryName</td>
                <td>@item.CategoryDesciption</td>
                <td>@item.ParentCategoryId</td>
                <td>@(item.IsActive == true ? "Active" : "Inactive")</td>
                <td>
                    <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#updateModal-@item.CategoryId">Edit</button>
                    <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.CategoryId">Delete</button>
                </td>
            </tr>

            <!-- Update Modal -->
            <div class="modal fade" id="updateModal-@item.CategoryId" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="Update" method="post">
                            <input type="hidden" name="id" value="@item.CategoryId" />
                            <div class="modal-header">
                                <h5 class="modal-title">Edit Category</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label">Name</label>
                                    <input type="text" name="CategoryName" class="form-control" value="@item.CategoryName" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Description</label>
                                    <input type="text" name="CategoryDesciption" class="form-control" value="@item.CategoryDesciption" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Parent Category ID</label>
                                    <input type="number" name="ParentCategoryId" class="form-control" value="@item.ParentCategoryId" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Status</label>
                                    <select name="IsActive" class="form-select">
                                        <option value="true" selected="@(item.IsActive == true)">Active</option>
                                        <option value="false" selected="@(item.IsActive == false)">Inactive</option>
                                    </select>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                <button type="submit" class="btn btn-primary">Save changes</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Delete Modal -->
            <div class="modal fade" id="deleteModal-@item.CategoryId" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="Delete" method="post">
                            <input type="hidden" name="id" value="@item.CategoryId" />
                            <div class="modal-header">
                                <h5 class="modal-title">Delete Confirmation</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                Are you sure you want to delete category: <strong>@item.CategoryName</strong>?
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </tbody>
</table>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Create Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" name="CategoryName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <input type="text" name="CategoryDesciption" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Parent Category ID</label>
                        <input type="number" name="ParentCategoryId" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select name="IsActive" class="form-select">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>
