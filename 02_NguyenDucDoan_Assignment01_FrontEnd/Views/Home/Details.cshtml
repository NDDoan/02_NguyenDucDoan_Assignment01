@model _02_NguyenDucDoan_Assignment01_FrontEnd.Models.NewsArticleDTO
@{
    ViewData["Title"] = Model.NewsTitle;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.NewsTitle</li>
                </ol>
            </nav>

            <article>
                <header class="mb-4">
                    <h1 class="fw-bolder mb-1">@Model.NewsTitle</h1>
                    <div class="text-muted fst-italic mb-2">Đăng bởi @Model.CreatedByName vào ngày @(Model.CreatedDate?.ToString("dd/MM/yyyy"))</div>
                    <span class="badge bg-secondary text-decoration-none link-light">@Model.CategoryName</span>
                    @if (Model.ModifiedDate.HasValue)
                    {
                        <div class="text-muted mt-2" style="font-size: 0.85em;">Cập nhật lần cuối: @(Model.ModifiedDate?.ToString("dd/MM/yyyy HH:mm"))</div>
                    }
                </header>

                @if (!string.IsNullOrEmpty(Model.Headline))
                {
                    <div class="mb-4">
                        <h4 class="fw-bold">@Model.Headline</h4>
                    </div>
                }

                <section class="mb-5">
                    <p class="fs-5 mb-4" style="white-space: pre-line;">@Model.NewsContent</p>
                </section>
                
                @if (!string.IsNullOrEmpty(Model.NewsSource))
                {
                    <div class="mt-4 pt-3 border-top text-end text-muted">
                        <em>Nguồn: @Model.NewsSource</em>
                    </div>
                }
            </article>

            <div class="mt-5 mb-5 text-center">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>
